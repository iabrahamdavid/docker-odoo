<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_payment_request" model="ir.actions.report">
        <field name="name">Solicitud de Pago</field>
        <field name="model">payment.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">payment_request.report_payment_request</field>
        <field name="report_file">payment_request.report_payment_request</field>
        <field name="print_report_name">'Solicitud de Pago - %s' % object.name</field>
        <field name="binding_model_id" ref="model_payment_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_payment_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Solicitud de Pago <span t-field="doc.name"/></h2>
                        <table class="table table-sm">
                            <tr><th>Proveedor</th><td><span t-field="doc.partner_id"/></td></tr>
                            <tr><th>Solicitante</th><td><span t-field="doc.applicant_id"/></td></tr>
                            <tr><th>Fecha</th><td><span t-field="doc.date"/></td></tr>
                            <tr><th>Monto</th><td><span t-field="doc.amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                            <tr><th>Estado</th><td><span t-field="doc.state"/></td></tr>
                            <tr><th>Concepto</th><td><span t-field="doc.concept"/></td></tr>
                        </table>
                        <h4>Aprobación</h4>
                        <table class="table table-sm">
                            <t t-if="doc.approved_by_id">
                                <tr><th>Aprobado por</th><td><span t-field="doc.approved_by_id"/></td></tr>
                                <tr><th>Fecha de aprobación</th><td><span t-field="doc.approved_date"/></td></tr>
                            </t>
                            <tr t-else=""><td>Pendiente de aprobación</td></tr>
                            <tr t-if="doc.payment_id"><th>Pago</th><td><span t-field="doc.payment_id"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
