<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_request" model="ir.module.category">
        <field name="name">Solicitudes de Pago</field>
        <field name="description">Gestión y control de solicitudes de pago a proveedores.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="group_payment_request_manager" model="res.groups">
        <field name="name">Tesorería / Responsable</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <!-- account.group_account_invoice is the minimum Odoo group allowed to create account.payment -->
        <field name="implied_ids" eval="[(4, ref('group_payment_request_approver')), (4, ref('account.group_account_invoice'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Reglas de Registro (Record Rules) -->
    <record id="payment_request_rule_multi_company" model="ir.rule">
        <field name="name">Solicitudes de Pago: multi-compañía</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="payment_request_rule_applicant" model="ir.rule">
        <field name="name">Solicitudes de Pago: el solicitante solo ve las suyas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('applicant_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="payment_request_rule_approver" model="ir.rule">
        <field name="name">Solicitudes de Pago: aprobador y tesorería ven todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_approver'))]"/>
    </record>
</odoo>

