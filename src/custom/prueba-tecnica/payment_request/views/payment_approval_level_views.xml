<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_approval_level_list" model="ir.ui.view">
        <field name="name">payment.approval.level.list</field>
        <field name="model">payment.approval.level</field>
        <field name="arch" type="xml">
            <list string="Niveles de Aprobación" editable="bottom">
                <field name="min_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="approver_id"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_payment_approval_level" model="ir.actions.act_window">
        <field name="name">Niveles de Aprobación</field>
        <field name="res_model">payment.approval.level</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure quién aprueba las solicitudes según su monto
            </p>
            <p>
                Cada solicitud la aprueba el nivel con el mayor monto mínimo que no supere su monto.
            </p>
        </field>
    </record>
</odoo>
