<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_pay_wizard_form" model="ir.ui.view">
        <field name="name">payment.request.pay.wizard.form</field>
        <field name="model">payment.request.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Pagar Solicitud de Pago">
                <group>
                    <field name="request_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="journal_id"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Registrar pago" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_request_pay_wizard" model="ir.actions.act_window">
        <field name="name">Pagar Solicitud de Pago</field>
        <field name="res_model">payment.request.pay.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
