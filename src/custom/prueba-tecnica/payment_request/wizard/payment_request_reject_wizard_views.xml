<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">payment.request.reject.wizard.form</field>
        <field name="model">payment.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Solicitud de Pago">
                <group>
                    <field name="request_id"/>
                    <field name="reason" placeholder="Indique por qué se rechaza la solicitud. El solicitante lo verá en el historial."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Rechazar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_request_reject_wizard" model="ir.actions.act_window">
        <field name="name">Rechazar Solicitud de Pago</field>
        <field name="res_model">payment.request.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
