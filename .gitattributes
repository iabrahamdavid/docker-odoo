# Ensure shell scripts, docker resources and executables always have LF line endings
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf
.resources/bin/* text eol=lf
.resources/entrypoint.d/* text eol=lf
.resources/conf.d/* text eol=lf
scripts/* text eol=lf
odoo text eol=lf
odoo-tui text eol=lf

